# Copy to .env to override the compose defaults. Placeholder values only.
POSTGRES_USER=qirsh
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=qirsh
RABBITMQ_PASSWORD=change-me
# true = on an empty database, ingest the invented messages in seed/sms-samples.json
QIRSH_DEMO_DATA=false
# Set to http://aspire-dashboard:18889 and run with --profile obs to see traces
OTEL_EXPORTER_OTLP_ENDPOINT=
# Only used when Messaging__Transport=AzureServiceBus (Azure deployment): the namespace connection string
ConnectionStrings__ServiceBus=
